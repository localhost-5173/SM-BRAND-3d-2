# ============================================================
# SM BRAND — Environment Variables Configuration Template
# Copy this file to .env and configure real credentials.
# NEVER commit the actual .env file to version control.
# ============================================================

# Server Environment
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/sm_brand?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/sm_brand

# JWT Authentication
# Generate a secure string (e.g. openssl rand -base64 32)
JWT_SECRET=replace_with_a_secure_cryptographic_secret_min_32_characters
JWT_EXPIRES_IN=7d

# Cloudinary CDN Credentials
CLOUDINARY_CLOUD_NAME=smbrand
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Origin & Host Security (used for CSRF check on state-changing admin routes)
FRONTEND_URL=http://localhost:5000
